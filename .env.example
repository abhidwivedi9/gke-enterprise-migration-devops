# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
#   cp .env.example .env
#
# DUMMY VALUES ONLY in this file.
#
# Note what is NOT here: no service-account JSON, no API key, no password.
# That is deliberate. GCP access comes from `gcloud auth application-default
# login` locally and from Workload Identity Federation in CI. If you ever find
# yourself wanting to add a credential to this file, read SECURITY.md first.

# ---------------------------------------------------------------------------
# GCP targeting
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=my-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

CLUSTER_NAME=orders-api-dev-gke
ARTIFACT_REGISTRY_REPO=orders

# Full image path: REGION-docker.pkg.dev/PROJECT/REPO/IMAGE
IMAGE_REPOSITORY=us-central1-docker.pkg.dev/my-gcp-project-id/orders/orders-api

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=orders-api
APP_VERSION=2.4.17
NAMESPACE=orders
HELM_RELEASE=orders-api

# ---------------------------------------------------------------------------
# Local development only
#
# A real DSN belongs in Secret Manager, never in a file on disk. This value is
# a throwaway for `docker run` against a local database.
# ---------------------------------------------------------------------------
ORDERS_DB_DSN=postgresql://demo:demo@localhost:5432/orders
LOG_LEVEL=INFO
ENVIRONMENT=local
